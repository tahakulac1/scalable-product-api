PORT=3000

# Uzun ve rastgele bir değer koyun, örn: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=buraya-uzun-rastgele-bir-deger-yazin

# Docker Compose dışında (lokalde) çalıştırırken kullanılır; compose bu değerleri kendisi verir
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scalable_product_db
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# Nginx vb. bir reverse proxy arkasındaysanız true yapın
TRUST_PROXY=false
